---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  bodyClass?: string;
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description = '',
  image = 'img/logo-fatima.png',
  type = 'website',
  noindex = false,
  bodyClass = '',
  jsonLd = null
} = Astro.props;

const sitio = Astro.site ?? new URL(Astro.url.origin);
const base = import.meta.env.BASE_URL.replace(/\/*$/, '/');
const canonical = new URL(Astro.url.pathname === base.slice(0, -1) ? base : Astro.url.pathname, sitio);
const ogImage = new URL(`${base}${image}`, sitio);
const favicon = new URL(`${base}img/logo-fatima.png`, sitio);
const nombreSitio = 'Instituto Técnico Nuestra Señora de Fátima';
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <link rel="canonical" href={canonical.href} />}

  <meta property="og:site_name" content={nombreSitio} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:image" content={ogImage.href} />
  <meta property="og:locale" content="es_AR" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage.href} />

  {jsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <link rel="icon" href={favicon.href}>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="css/estilos.css" rel="stylesheet">
  <slot name="head" />
</head>
<body class:list={[bodyClass]}>
  <slot />
</body>
</html>
