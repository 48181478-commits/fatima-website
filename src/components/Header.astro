---
interface Props {
  activa?: 'galeria' | 'proyectos' | null;
}

const { activa = null } = Astro.props;
---

<!-- BARRA SUPERIOR -->
<div class="barra-superior d-none d-md-block">
  <div class="container d-flex justify-content-between align-items-center gap-4">
    <span>Secundaria Diurna · A-893 · Villa Soldati, CABA</span>
    <span class="d-flex gap-4 align-items-center">
      <span>Atención: lunes a viernes de 8 a 14 h</span>
      <a href="#" class="copiar-correo" data-correo="secretaria.sd@fatimarem.edu.ar" title="Copiar correo">secretaria.sd@fatimarem.edu.ar</a>
    </span>
  </div>
</div>

<!-- CABECERA (header + subheader) -->
<div class="cabecera sticky-top" id="inicio">
  <header class="encabezado">
    <div class="container encabezado-inner">
      <a class="marca" href="index.html">
        <img src="img/logo-fatima.png" alt="Logo del Instituto Nuestra Señora de Fátima">
        <span class="marca-texto">
          <span class="marca-nombre">Instituto Técnico Nuestra Señora de Fátima</span>
          <span class="marca-sub">Secundaria Diurna · A-893</span>
        </span>
      </a>
      <div class="encabezado-acciones">
        <a class="nav-acceder" href="admin.html">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Acceder
        </a>
        <a class="btn btn-donar" href="index.html#donaciones">Donar</a>
      </div>
    </div>
  </header>

  <nav class="subnav" aria-label="Navegación principal">
    <div class="container subnav-inner">
      <button class="subnav-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#submenu" aria-controls="submenu" aria-expanded="false" aria-label="Abrir menú">
        Menú <span class="subnav-icono">☰</span>
      </button>
      <ul class="subnav-menu collapse d-lg-flex" id="submenu">
        <li><a href="index.html">Inicio</a></li>
        <li class="dropdown">
          <a href="index.html#nosotros" class="dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">Sobre nosotros</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="index.html#historia">Nuestra historia</a></li>
            <li><a class="dropdown-item" href="index.html#marianistas">Red Marianista</a></li>
          </ul>
        </li>
        <li class="dropdown">
          <a href="index.html#orientaciones" class="dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">Orientaciones</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="index.html#gestion">Gestión y Administración de las Organizaciones</a></li>
            <li><a class="dropdown-item" href="index.html#computacion">Computación</a></li>
            <li><a class="dropdown-item" href="index.html#electromecanica">Electromecánica</a></li>
            <li><a class="dropdown-item" href="index.html#bachillerato">Bachiller en Ciencias Sociales</a></li>
          </ul>
        </li>
        <li>
          <a
            href="galeria.html"
            class:list={[{ active: activa === 'galeria' }]}
            aria-current={activa === 'galeria' ? 'page' : undefined}>Galería</a>
        </li>
        <li>
          <a
            href="proyectos.html"
            class:list={[{ active: activa === 'proyectos' }]}
            aria-current={activa === 'proyectos' ? 'page' : undefined}>Proyectos</a>
        </li>
        <li><a href="index.html#contacto">Contacto</a></li>
      </ul>
    </div>
  </nav>
</div>
