---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import contenido from '../contenido/galeria.html?raw';

const titulo = 'Galería de fotos — Instituto Técnico Nuestra Señora de Fátima';
const descripcion = 'Fotos del Instituto Técnico Nuestra Señora de Fátima, Secundaria Diurna A-893, Villa Soldati, CABA.';
---

<Base title={titulo} description={descripcion}>
  <Header activa="galeria" />
  <main set:html={contenido} />
  <Footer />

  <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline src="js/config.js"></script>
  <script is:inline src="js/galeria.js"></script>
  <script is:inline src="js/copiar-correo.js"></script>
  <script is:inline>
    document.querySelectorAll('#submenu a:not(.dropdown-toggle)').forEach(function (enlace) {
      enlace.addEventListener('click', function () {
        var menu = document.getElementById('submenu');
        if (menu.classList.contains('show')) bootstrap.Collapse.getOrCreateInstance(menu).hide();
      });
    });
  </script>
</Base>
